# Certificates come from Let's Encrypt on first request. RAUTEOS_HOSTS is a
# comma-separated list, so a temporary name can sit beside the real one while
# DNS moves.
{$RAUTEOS_HOSTS} {
	encode zstd gzip
	reverse_proxy app:8000
}

# The company website: static files, no app behind it.
{$WEBSITE_HOSTS} {
	root * /srv/website
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	file_server
}
